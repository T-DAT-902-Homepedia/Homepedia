# Identifiants de la couche données (compose.data.yml).
# Copier en `.env.data` et adapter, puis :
#   docker compose -f compose.data.yml --env-file .env.data up -d
# Le fichier `.env.data` est gitignoré (ne jamais committer de secrets).

# MinIO (stockage objet S3 — Bronze/Silver)
MINIO_ROOT_USER=homepedia
MINIO_ROOT_PASSWORD=changeme-minio

# PostGIS (couche Gold)
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=homepedia
